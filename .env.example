DATABASE_URL="postgresql://postgres:postgres@localhost:5432/turganov_seller?schema=public"
PORT=4000
API_PREFIX=api

# Allowed CORS origins (comma-separated, or * for all in development)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173


WB_SELLER_TOKEN_SHOP1=your_token_here
WB_SELLER_TOKEN_SHOP2=your_token_here
WB_SELLER_TOKEN_SHOP3=your_token_here
WB_SELLER_TOKEN_SHOP4=your_token_here
WB_SELLER_TOKEN_SHOP5=your_token_here

JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Separate encryption key for WB API tokens (AES-256-GCM)
# MUST be different from JWT_SECRET in production
TOKEN_ENCRYPTION_KEY=your_token_encryption_key_min_32_chars_change_me

# Initial Lead Admin (created on seed or startup if no LEAD_ADMIN exists)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin_secure_password_change_me
