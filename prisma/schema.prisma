generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  LEAD_ADMIN
}

enum WbTokenCategory {
  STANDARD
  CONTENT
  ANALYTICS
  PRICES
  MARKETPLACE
  QUESTIONS
  ADVERTS
  RECOMMENDATIONS
  FEEDBACKS_QUESTIONS
  BUYER_CHAT
  SUPPLIES
  RETURNS
  DOCUMENTS
}

model User {
  id String @id @default(uuid())

  username String @unique
  password String
  role     Role   @default(ADMIN)

  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Store {
  id String @id @default(uuid())

  name        String  @unique
  inn         String?
  description String?
  isActive    Boolean @default(true)

  tokens    WbApiToken[]
  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stores")
}

model WbApiToken {
  id String @id @default(uuid())

  storeId  String
  store    Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  token     String
  tokenName String
  category  WbTokenCategory

  isActive            Boolean   @default(true)
  consecutiveFailures Int       @default(0)
  expiresAt           DateTime?
  lastUsedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, category])
  @@map("wb_api_tokens")
}

model AuditLog {
  id String @id @default(uuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: SetNull)

  action    String
  module    String
  details   Json?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([storeId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
